{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "label": "Apex",
    "sector": "Sports & Fitness Tracking",
    "theme": "apex"
  },
  "typography": {
    "font-display": {
      "$value": "'Bricolage Grotesque', sans-serif",
      "$type": "fontFamily"
    },
    "font-body": {
