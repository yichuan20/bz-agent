# Backend URL for the Vite dev proxy. Leave blank to use the default (:18789).
# In production the backend serves the built SPA on the same origin so no proxy is needed.
# VITE_BACKEND_URL=http://localhost:18789

# Override the agent backend URL for direct (non-proxy) access.
# Leave blank in dev — the proxy handles /api/* and /healthz.
# VITE_AGENT_HTTP_URL=

# Platform API (BoltzHub — for the /chat, /products, /files pages).
# VITE_API_BASE_URL=https://boltzhub.com
# VITE_DYNAS_APP_ID=
