# Copy to .env and adjust. All values have sensible defaults except where noted.

# Default working directory for agent sessions (must be writable). Defaults to CWD.
# BZCODE_CWD=/home/boltzagent/workspace

# bzcode home: credentials, api keys, session transcripts/config. Must be writable.
BZ_HOME=/usr/local/boltzbit

# bzcode binary name or path (resolved against PATH).
BZCODE_PATH=bzcode

# HTTP + SSE port.
PORT=18789

# Seconds an idle (no-client) agent runtime lives before being reaped.
AGENT_IDLE_TIMEOUT=300

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
