{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Boltzbit AppFlow Design Tokens",
    "version": "1.0.0",
    "description": "Brutal Minimalist design system tokens for the Boltzbit AppFlow AI marketplace platform.",
    "philosophy": "No gradients (except avatars), no box-shadows (except hover/dropdowns), only flat 1px borders. 8pt grid. Pixel-art SVG icons only.",
    "fonts": {
      "imports": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Martian+Mono:wght@400;500;600;700&display=swap"
    }
  },

  "color": {
    "accent": {
      "blue": {
        "value": "#1473DF",
        "description": "Links, active states, primary CTA, focus rings"
      },
      "green": {
        "value": "#3FDC7E",
        "description": "Success states, positive numbers, earnings indicators"
      },
      "orange": { "value": "#F59E0B", "description": "Warnings, pending states" },
      "red": {
        "value": "#FA4B42",
        "description": "Errors, destructive actions, notification badges"
      },
      "pink": { "value": "#EC4899", "description": "Category accent (interests page)" },
      "cyan": { "value": "#06B6D4", "description": "Category accent (interests page)" },
      "yellow": { "value": "#EAB308", "description": "Category accent (interests page)" }
    },
    "light": {
      "bg": {
        "primary": { "value": "#FFFFFF", "description": "Main background, cards, navbar" },
        "secondary": { "value": "#FAFAFA", "description": "Page background, form inputs" },
        "tertiary": {
          "value": "#F5F5F5",
          "description": "Card backgrounds, icon containers, table headers"
        }
      },
      "text": {
        "primary": { "value": "#000000", "description": "Main body text, headings" },
        "secondary": {
          "value": "#737373",
          "description": "Secondary text, meta info, descriptions"
        },
        "tertiary": { "value": "#A3A3A3", "description": "Disabled text, timestamps, placeholders" }
      },
      "border": {
        "primary": { "value": "#E5E5E5", "description": "All standard borders" },
        "secondary": { "value": "#D4D4D4", "description": "Secondary/heavier borders" }
      }
    },
    "dark": {
      "bg": {
        "primary": { "value": "#000000" },
        "secondary": { "value": "#0A0A0A" },
        "tertiary": { "value": "#1A1A1A" }
      },
      "text": {
        "primary": { "value": "#FFFFFF" },
        "secondary": { "value": "#A3A3A3" },
        "tertiary": { "value": "#737373" }
      },
      "border": {
        "primary": { "value": "#262626" },
        "secondary": { "value": "#1F1F1F" }
      }
    },
    "overlay": {
      "modal": { "value": "rgba(0, 0, 0, 0.5)", "description": "Modal backdrop" }
    }
  },

  "typography": {
    "fontFamily": {
      "heading": {
        "value": "'Martian Mono', monospace",
        "description": "Headlines, section titles, stat values, credits"
      },
      "body": {
        "value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
        "description": "Body text, buttons, form labels"
      }
    },
    "preset": {
      "h1": {
        "fontFamily": "{typography.fontFamily.heading}",
        "fontSize": "28px",
        "fontWeight": "400",
        "lineHeight": "1.3"
      },
      "sectionTitle": {
        "fontFamily": "{typography.fontFamily.heading}",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "1.4"
      },
      "statValue": {
        "fontFamily": "{typography.fontFamily.heading}",
        "fontSize": "32px",
        "fontWeight": "700",
        "lineHeight": "1.2"
      },
      "credits": {
        "fontFamily": "{typography.fontFamily.heading}",
        "fontSize": "13px",
        "fontWeight": "500",
        "lineHeight": "1.4"
      },
      "bodyLarge": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "15px",
        "fontWeight": "400",
        "lineHeight": "1.6"
      },
      "bodyDefault": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "1.6"
      },
      "bodySmall": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "13px",
        "fontWeight": "400",
        "lineHeight": "1.5"
      },
      "caption": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "11px",
        "fontWeight": "500",
        "lineHeight": "1.4"
      },
      "buttonLarge": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "15px",
        "fontWeight": "600",
        "lineHeight": "1"
      },
      "buttonDefault": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "14px",
        "fontWeight": "600",
        "lineHeight": "1"
      },
      "buttonSmall": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "13px",
        "fontWeight": "600",
        "lineHeight": "1"
      },
      "tableHeader": {
        "fontFamily": "{typography.fontFamily.body}",
        "fontSize": "12px",
        "fontWeight": "700",
        "lineHeight": "1.4",
        "textTransform": "uppercase"
      }
    }
  },

  "spacing": {
    "xs": { "value": "8px", "description": "Minimal gaps, icon-to-text" },
    "sm": { "value": "16px", "description": "Small gaps, inner card padding" },
    "md": { "value": "24px", "description": "Standard gaps, section padding" },
    "lg": { "value": "32px", "description": "Large gaps, section margins" },
    "xl": { "value": "48px", "description": "Extra-large gaps, page sections" },
    "2xl": { "value": "64px", "description": "Maximum spacing, hero sections" }
  },

  "borderRadius": {
    "sm": { "value": "8px", "description": "Buttons, small cards, inputs, icon containers" },
    "md": { "value": "12px", "description": "Standard cards, dropdowns" },
    "lg": { "value": "16px", "description": "Large cards, modals" }
  },

  "borderWidth": {
    "default": { "value": "1px", "description": "All borders are 1px solid — no thicker borders" }
  },

  "shadow": {
    "none": { "value": "none", "description": "Default — brutal minimalism = no shadows" },
    "dropdown": { "value": "0 4px 12px rgba(0, 0, 0, 0.1)", "description": "Dropdowns only" }
  },

  "transition": {
    "default": {
      "value": "all 0.2s ease",
      "description": "Standard transition for all interactive elements"
    }
  },

  "animation": {
    "fadeIn": {
      "keyframes": "from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); }",
      "duration": "0.4s",
      "easing": "ease"
    },
    "pop": {
      "keyframes": "0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1); }",
      "duration": "0.2s",
      "easing": "ease"
    },
    "spin": {
      "keyframes": "to { transform: rotate(360deg); }",
      "duration": "0.8s",
      "easing": "linear"
    }
  },

  "layout": {
    "maxWidth": {
      "container": { "value": "1400px", "description": "Max content width" },
      "modal": { "value": "480px", "description": "Max modal width" }
    },
    "navbar": {
      "padding": "16px 32px",
      "position": "sticky",
      "zIndex": "1000",
      "borderBottom": "1px solid var(--border-primary)"
    },
    "zIndex": {
      "navbar": { "value": "1000" },
      "dropdown": { "value": "1500" },
      "modal": { "value": "2000" }
    }
  },

  "breakpoint": {
    "mobile": { "value": "768px", "description": "< 768px: hamburger menu, stacked layout" },
    "tablet": { "value": "1024px", "description": "768–1024px: reduced nav, 2-col grids" },
    "desktop": { "value": "1024px", "description": "> 1024px: full navigation, multi-col grids" }
  },

  "component": {
    "button": {
      "primary": {
        "background": "{color.light.text.primary}",
        "color": "{color.light.bg.primary}",
        "borderRadius": "{borderRadius.sm}",
        "padding": "10px 20px",
        "fontSize": "14px",
        "fontWeight": "600"
      },
      "secondary": {
        "background": "{color.light.bg.tertiary}",
        "color": "{color.light.text.primary}",
        "border": "1px solid {color.light.border.primary}",
        "borderRadius": "{borderRadius.sm}",
        "padding": "10px 20px"
      },
      "accent": {
        "background": "{color.accent.blue}",
        "color": "#FFFFFF",
        "borderRadius": "{borderRadius.sm}",
        "padding": "10px 20px"
      },
      "cta": {
        "padding": "16px 24px",
        "fontSize": "15px",
        "fontWeight": "600",
        "width": "100%"
      },
      "small": {
        "padding": "8px 16px",
        "fontSize": "13px",
        "fontWeight": "600"
      }
    },
    "input": {
      "background": "{color.light.bg.secondary}",
      "border": "1px solid {color.light.border.primary}",
      "borderRadius": "{borderRadius.sm}",
      "padding": "12px 16px",
      "fontSize": "14px",
      "focusBorderColor": "{color.accent.blue}"
    },
    "card": {
      "section": {
        "background": "{color.light.bg.primary}",
        "border": "1px solid {color.light.border.primary}",
        "borderRadius": "{borderRadius.md}",
        "padding": "{spacing.md}"
      },
      "stat": {
        "description": "White/dark card with 1px border, icon top-right, value in Martian Mono bold, change indicator below"
      }
    },
    "modal": {
      "overlay": "{color.overlay.modal}",
      "background": "{color.light.bg.primary}",
      "maxWidth": "{layout.maxWidth.modal}",
      "borderRadius": "{borderRadius.lg}",
      "zIndex": "{layout.zIndex.modal}"
    },
    "dropdown": {
      "background": "{color.light.bg.primary}",
      "border": "1px solid {color.light.border.primary}",
      "borderRadius": "{borderRadius.md}",
      "shadow": "{shadow.dropdown}"
    },
    "table": {
      "headerBackground": "{color.light.bg.tertiary}",
      "headerFontSize": "12px",
      "headerFontWeight": "700",
      "headerTextTransform": "uppercase",
      "rowBorder": "1px solid {color.light.border.primary}"
    }
  },

  "interaction": {
    "hover": {
      "card": {
        "borderColor": "{color.light.text.primary}",
        "transform": "translateY(-2px)",
        "transition": "{transition.default}",
        "note": "NO box-shadows on card hover"
      },
      "button": {
        "opacity": "0.9",
        "transform": "translateY(-1px)"
      },
      "link": {
        "color": "{color.accent.blue}"
      }
    },
    "focus": {
      "input": {
        "borderColor": "{color.accent.blue}",
        "outline": "none"
      }
    },
    "disabled": {
      "opacity": "0.4",
      "cursor": "not-allowed"
    }
  },

  "icon": {
    "style": "pixel-art SVG",
    "colorMode": "monochrome (currentColor)",
    "sizes": {
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px"
    },
    "viewBox": "16–24px typical",
    "fill": "currentColor or stroke currentColor",
    "note": "No colored icon backgrounds. All icons must be pixel-art style."
  },

  "theme": {
    "mechanism": "data-theme attribute on <html>",
    "values": ["light", "dark"],
    "storage": "localStorage key: 'theme'",
    "script": "document.documentElement.setAttribute('data-theme', theme)"
  }
}
